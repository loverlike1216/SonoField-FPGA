* text=auto
*.sv text eol=lf
*.py text eol=lf
*.tcl text eol=lf
*.md text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.txt text eol=lf
*.log text eol=lf -whitespace
*.png binary
*.pdf binary
*.epro2 binary
*.eprj2 binary
*.zip binary
# Native exported SVG is a large generated artifact; retain exact bytes.
PCB/V1/project/*.svg binary

# Verbatim public transcript whitespace is source evidence, not source-code style.
AI-interaction-memory/codex/*.md text eol=lf -whitespace

# Historical governance snapshots preserve original bytes, including line endings.
archive/historical_evidence/pre_v5_20261008/** -text

# Native tool reports and observed command transcripts retain tool formatting.
*.rpt text eol=lf -whitespace
v5/evidence/**/commands.txt text eol=lf -whitespace
archive/historical_evidence/pre_v5_20261008/** -whitespace
AI-interaction-memory/codex/instructions/*.md text eol=lf -whitespace

# Exact frozen Git blob bytes; no CRLF normalization or filters in the archive.
history_old/** -text -filter -ident -whitespace
