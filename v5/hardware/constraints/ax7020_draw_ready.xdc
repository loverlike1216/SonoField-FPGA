set_property DRIVE 8 [get_ports {rx_blank_0[1]}]
set_property SLEW FAST [get_ports {rx_blank_0[1]}]
set_property PACKAGE_PIN D19 [get_ports {physical_health_0[2]}]
set_property IOSTANDARD LVCMOS33 [get_ports {physical_health_0[2]}]
set_property PACKAGE_PIN E19 [get_ports {physical_health_0[4]}]
set_property IOSTANDARD LVCMOS33 [get_ports {physical_health_0[4]}]
set_property PACKAGE_PIN E18 [get_ports {adc_reset_0}]
set_property IOSTANDARD LVCMOS33 [get_ports {adc_reset_0}]
set_property DRIVE 8 [get_ports {adc_reset_0}]
set_property SLEW FAST [get_ports {adc_reset_0}]
set_property PACKAGE_PIN G18 [get_ports {IIC_0_scl_io}]
set_property IOSTANDARD LVCMOS33 [get_ports {IIC_0_scl_io}]
set_property PACKAGE_PIN G17 [get_ports {IIC_0_sda_io}]
set_property IOSTANDARD LVCMOS33 [get_ports {IIC_0_sda_io}]
set_property PACKAGE_PIN H17 [get_ports {physical_health_0[0]}]
set_property IOSTANDARD LVCMOS33 [get_ports {physical_health_0[0]}]
set_property PACKAGE_PIN H16 [get_ports {adc_dout_0[4]}]
set_property IOSTANDARD LVCMOS33 [get_ports {adc_dout_0[4]}]
set_property PACKAGE_PIN G15 [get_ports {adc_dout_0[5]}]
set_property IOSTANDARD LVCMOS33 [get_ports {adc_dout_0[5]}]
set_property PACKAGE_PIN H15 [get_ports {adc_dout_0[6]}]
set_property IOSTANDARD LVCMOS33 [get_ports {adc_dout_0[6]}]
set_property PACKAGE_PIN J14 [get_ports {adc_dout_0[7]}]
set_property IOSTANDARD LVCMOS33 [get_ports {adc_dout_0[7]}]
set_property PACKAGE_PIN U18 [get_ports ref_clk50_0]
set_property IOSTANDARD LVCMOS33 [get_ports ref_clk50_0]
create_clock -name ref50 -period 20.000 [get_ports ref_clk50_0]
#Source synchronous burst TX: constrain actual register-to-pin path, SI checks relative clock/data.
set tx_ports [get_ports {serial_data_0[*] shift_clock_0 latch_clock_0}]
set tx_regs [get_cells -hier -include_replicated_objects -filter {NAME =~ *tx44*serial*tx*serial_data_reg* || NAME =~ *tx44*serial*tx*shift_clock_reg || NAME =~ *tx44*serial*tx*latch_clock_reg}]
set_property IOB TRUE $tx_regs
set_max_delay -datapath_only 4.5 -from $tx_regs -to $tx_ports
#ADC old-data capture is enabled once per16corecycles, at generated SCLK rising.
set adc_clk_reg [get_cells -hier -filter {NAME =~ *c16*adc*serial*sclk_reg}]
create_generated_clock -name ADC_SCLK -source [get_pins -of_objects $adc_clk_reg -filter {REF_PIN_NAME == C}] -divide_by 16 [get_ports adc_sclk_0]
set_input_delay -clock ADC_SCLK -max 44.0 [get_ports {adc_dout_0[*]}]
set_input_delay -clock ADC_SCLK -min 0.0 [get_ports {adc_dout_0[*]}]
set adc_capture [get_cells -hier -filter {NAME =~ *c16*adc*serial*lane_reg*}]
set_multicycle_path 16 -setup -end -from [get_ports {adc_dout_0[*]}] -to $adc_capture
set_multicycle_path 15 -hold -end -from [get_ports {adc_dout_0[*]}] -to $adc_capture
#Asynchronous board-health and BUSY inputs terminate at explicit synchronizers.
set health_first [get_cells -hier -filter {NAME =~ *supervisor*kill_sync_reg?0?}]
set busy_first [get_cells -hier -filter {NAME =~ *c16*adc*busy_sync_reg?0?}]
set_false_path -from [get_ports {physical_health_0[*]}] -to $health_first
set_false_path -from [get_ports adc_busy_0] -to $busy_first
#Asynchronous fault assertion to latch reset pins is deliberately independent of clock.
set fault_regs [get_cells -hier -filter {NAME =~ *supervisor*fault_latched_reg}]
set_false_path -from [get_ports {physical_health_0[*]}] -to [get_pins -of_objects $fault_regs -filter {REF_PIN_NAME == CLR || REF_PIN_NAME == PRE}]
#Low-speed I2C is self-clocked and open-drain; use generous physical pad budgets.
set_max_delay -datapath_only 1000.0 -to [get_ports {IIC_0_scl_io IIC_0_sda_io}]
set_max_delay -datapath_only 1000.0 -from [get_ports {IIC_0_scl_io IIC_0_sda_io}]
#Enable/reset/control outputs are slow controls; no exception between132/264MHz.
set_max_delay -datapath_only 20.0 -to [get_ports {adc_reset_0 adc_convst_0 adc_cs_n_0 adc_sclk_0 adc_sdi_0 rx_blank_0[*] output_disable_0 heartbeat_0 efuse_up_0 efuse_dn_0}]

#Snapshot held>=96ns; two fast request stages precede enabled capture.
set snap [get_cells -hier -filter {NAME =~ *tx44*serial*snapshot_reg*}]
set fast_data [get_cells -hier -filter {NAME =~ *tx44*serial*fast_hold_reg*}]
set_multicycle_path 2 -setup -end -from $snap -to $fast_data
set_multicycle_path 1 -hold -end -from $snap -to $fast_data

#Canonical asynchronousassert/synchronousrelease reset synchronizer only.
set fast_rst_sync [get_cells -hier -filter {NAME =~ *tx44*serial*fast_release_reg*}]
set_false_path -to [get_pins -of_objects $fast_rst_sync -filter {REF_PIN_NAME == CLR}]


#ADC SCLK pad duty is checked independently against AHCT244 CL15 timing.
set_property IOB TRUE [get_cells -hier -filter {NAME =~ *c16*adc*serial*sclk_reg}]
